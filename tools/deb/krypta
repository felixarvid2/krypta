#!/usr/bin/python3
# Krypta – startare för Debian-paketet. Startar en liten webbserver på 127.0.0.1 som serverar spelet
# ur /usr/share/krypta och öppnar det i webbläsaren. Porten är fast (47823) så att sparningar i
# webbläsaren (localStorage hör till adressen) finns kvar mellan gångerna; kör servern redan öppnas bara
# webbläsaren. Flaggor: --port N, --no-browser, --stop.
import http.server, os, socket, socketserver, sys, threading, webbrowser, urllib.request, signal

ROOT = os.environ.get('KRYPTA_ROOT', '/usr/share/krypta')
PORT = 47823
args = sys.argv[1:]
if '--port' in args: PORT = int(args[args.index('--port') + 1])
RUN = os.environ.get('XDG_RUNTIME_DIR') or os.path.join(os.path.expanduser('~'), '.cache')
PIDF = os.path.join(RUN, 'krypta-%d.pid' % PORT)
URL = 'http://127.0.0.1:%d/index.html' % PORT

def ours():
    try:
        with urllib.request.urlopen('http://127.0.0.1:%d/.krypta' % PORT, timeout=1) as r: return r.read() == b'krypta'
    except Exception: return False

if '--stop' in args:
    try:
        os.kill(int(open(PIDF).read()), signal.SIGTERM); os.remove(PIDF); print('Krypta-servern är stoppad.')
    except Exception: print('Ingen Krypta-server körs på port %d.' % PORT)
    sys.exit(0)

if ours():
    print('Krypta körs redan:', URL)
    if '--no-browser' not in args: webbrowser.open(URL)
    sys.exit(0)

class H(http.server.SimpleHTTPRequestHandler):
    extensions_map = {**http.server.SimpleHTTPRequestHandler.extensions_map, '.js': 'text/javascript', '.ogg': 'audio/ogg', '.ttf': 'font/ttf', '.json': 'application/json'}
    def __init__(self, *a, **k): super().__init__(*a, directory=ROOT, **k)
    def log_message(self, *a): pass
    def do_GET(self):
        if self.path == '/.krypta':
            self.send_response(200); self.send_header('Content-Type', 'text/plain'); self.end_headers(); self.wfile.write(b'krypta'); return
        super().do_GET()

class S(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True; allow_reuse_address = True

try:
    srv = S(('127.0.0.1', PORT), H)
except OSError:
    sys.exit('Port %d är upptagen av ett annat program. Starta med: krypta --port <annan port>' % PORT)
try:
    os.makedirs(RUN, exist_ok=True); open(PIDF, 'w').write(str(os.getpid()))
except Exception: pass
print('Krypta:', URL, '(stoppa med Ctrl+C eller "krypta --stop")')
if '--no-browser' not in args: threading.Timer(0.4, lambda: webbrowser.open(URL)).start()
try: srv.serve_forever()
except KeyboardInterrupt: pass
finally:
    try: os.remove(PIDF)
    except Exception: pass
